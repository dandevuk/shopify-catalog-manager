# Copy to .env and adjust if needed.
# `shopify app dev` supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL
# and SCOPES itself, so they don't need to be set here for local development.

# Postgres from docker-compose.yml
DATABASE_URL="postgresql://catalogs:catalogs@localhost:5432/catalogs_dev?schema=public"

# Redis from docker-compose.yml (used by the job queue, coming later in Phase 1)
REDIS_URL="redis://localhost:6379"
