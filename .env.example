# Copy to .env and adjust if needed.
# `shopify app dev` supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL
# and SCOPES to its own child process, so `npm run dev` doesn't need them set
# here. `npm run worker` (app/worker.ts, Phase 1 step 5) runs standalone and
# does need SHOPIFY_API_KEY and SHOPIFY_API_SECRET in .env, to build admin
# API clients for background jobs (unauthenticated.admin) and refresh expiring
# offline tokens. Run `npm run env` (shopify app env pull) once to fetch them.

# Postgres from docker-compose.yml
DATABASE_URL="postgresql://catalogs:catalogs@localhost:5432/catalogs_dev?schema=public"

# Redis from docker-compose.yml. Used by the job queue (app/lib/queue), which
# needs `docker compose up -d` (npm run db:up) and `npm run worker` running.
REDIS_URL="redis://localhost:6379"

# The app's handle from the Partner Dashboard (the "apps/<handle>/" segment in
# its admin URL, e.g. https://admin.shopify.com/store/x/apps/<handle>/...).
# Differs between the dev and production apps. Used to build the admin links
# the Sidekick tools return (app/lib/sidekick/admin-url.ts); left unset, those
# tools omit the url field rather than guess.
SHOPIFY_APP_HANDLE="smart-catalogs-dev"
